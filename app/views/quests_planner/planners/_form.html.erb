
<%= simple_form_for(@planner, url: quests_planner_planners_path) do |f| %>
  <%= f.error_notification %>
  <%= f.error_notification message: f.object.errors[:base].to_sentence if f.object.errors[:base].present? %>

  <div class="form-inputs">
    <%= f.input :title %>
  </div>

  <br>
  <div class="form-inputs">
    <%= f.label "Select quest:" %>
    <%= f.collection_select(:quest_id, Quests::Quest.all, :id, :name, {:prompt => true}, {class: "newdropdown-menu"}) %>
  </div>

  <br>
  <div class="form-inputs">
    <%= f.label "Select if quest will be implemented individually:" %> <br />
    <%= f.check_box :is_individual_planned %> <br />
  </div>


<!--  <br>-->
<!--  <div class="form-inputs">-->
<!--    <%#= f.label "Members poisitions selection:" %> <br />-->
