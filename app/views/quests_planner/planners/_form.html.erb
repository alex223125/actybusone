    <%#= f.collection_select(:member_position_ids, QuestsPlanners::MemberPosition.all, :id, :title, {:multiple => true}, size: QuestsPlanners::MemberPosition.all.length) %>
    <%#= f.collection_select :member_position_ids,QuestsPlanners::MemberPosition.all, :id, :title, :prompt => "Category", :multiple => true %>
    <%#= f.collection_select(:member_position_ids, QuestsPlanners::MemberPosition.all, :id, :title, {:prompt => true}, {class: "newdropdown-menu", id: "newdropdown"}) %>
<!--  </div>-->

