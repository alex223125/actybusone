<div id="<%= dom_id member_position %>">
  <p>
    <strong>Title:</strong>
    <%= member_position.title %>
  </p>

  <p>
    <strong>Planner:</strong>
    <%= member_position.planner.try(:title) %>
  </p>

  <p>
    <strong>User who filled member position</strong>
    <%= member_position.user.try(:email) %>
  </p>

</div>
