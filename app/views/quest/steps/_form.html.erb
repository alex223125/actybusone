
<%= simple_form_for(@step, url: quest_steps_path) do |f| %>
  <%= f.error_notification %>
  <%= f.error_notification message: f.object.errors[:base].to_sentence if f.object.errors[:base].present? %>

  <div class="form-inputs">

    0.1 Select quest:
    <%= f.collection_select(:quest_id, Quests::Quest.all, :id, :name, {:prompt => true}, {class: "newdropdown-menu", id: "newdropdown"}) %>

    0.2 Select available algorithm:
    <%= f.collection_select(:algorithm_id, Quests::Algorithm.all, :id, :title, {:prompt => true}, {class: "newdropdown-menu", id: "newdropdown"}) %>

    <%= f.input :title %>
    <%= f.input :description %>
  </div>




  <div class="form-actions">
    <%= f.button :submit %>
  </div>
<% end %>
