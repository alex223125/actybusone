<div id="<%= dom_id step %>">
  <p>
    <strong>Title:</strong>
    <%= step.title %>
  </p>

  <p>
    <strong>Description:</strong>
    <%= step.description %>
  </p>

  <p>
    <strong>Quest title:</strong>
    <%= step.quest.try(:name) %>
  </p>

  <p>
    <strong>Algorithm:</strong>
    <%= step.algorithm.try(:title) %>
  </p>

</div>
