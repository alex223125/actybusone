<div id="<%= dom_id quest %>">
  <p>
    <strong>Name:</strong>
    <%= quest.name %>
  </p>

  <p>
    <strong>Description:</strong>
    <%= quest.description %>
  </p>

  <p>
    <strong>Difficulty:</strong>
    <%= quest.difficulty.title %>
  </p>

  <p>
    <strong>Regularity:</strong>
    <%= quest.regularity.title %>
  </p>

  <p>
    <strong>Recommended amount of members from:</strong>
    <%= quest.recommended_amount_of_members_from %>
  </p>

  <p>
    <strong>Recommended amount of members to:</strong>
    <%= quest.recommended_amount_of_members_to %>
  </p>

  <p>
    <strong>Recommended amount of time from (minutes):</strong>
    <%= quest.recommended_amount_of_time_from %>
  </p>

  <p>
    <strong>Recommended amount of time to(minutes):</strong>
    <%= quest.recommended_amount_of_time_to %>
  </p>

</div>
