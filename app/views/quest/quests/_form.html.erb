
<%= simple_form_for(@quest, url: quest_quests_path) do |f| %>
  <%= f.error_notification %>
  <%= f.error_notification message: f.object.errors[:base].to_sentence if f.object.errors[:base].present? %>

  <div class="form-inputs">
    <%= f.input :name %>
    <%= f.input :description %>

    Difficulty selection
    <%= f.collection_select(:difficulty_id, Quests::Difficulty.all, :id, :title, {:prompt => true}, {class: "newdropdown-menu", id: "newdropdown"}) %>

    Regularity selection
    <%= f.collection_select(:regularity_id, Quests::Regularity.all, :id, :title, {:prompt => true}, {class: "newdropdown-menu", id: "newdropdown"}) %>

    Recommended amount of quest members from:
    <%= f.input :recommended_amount_of_members_from, collection: 1..500, label: "Recommended amount of quest members from: ", class: 'form-control' %>

    Recommended amount of quest members to:
    <%= f.input :recommended_amount_of_members_to, collection: 1..500, label: "Recommended amount of quest members to: ", class: 'form-control' %>

    Recommended amount of time from:
    <%= f.number_field :recommended_amount_of_time_from %>

    Recommended amount of time to:
    <%= f.number_field :recommended_amount_of_time_to %>



    <!--    1 - really easy-->
<!--    10 - really hard-->
    <%#= f.select :difficulty, ((1..10).map {|i| [i,i] }) %>
    <%#= f.input :difficulty %>



  </div>

  <div class="form-actions">
    <%= f.button :submit %>
  </div>
<% end %>
