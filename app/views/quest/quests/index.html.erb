<p style="color: green"><%= notice %></p>

<h1>Quests</h1>

<div id="quests">
  <% @quests.each do |quest| %>
    <%= render "quest/planners/quest", :quest => quest %>
    <p>
      <%= link_to "Show this quest", quest_quests_path(quest) %>
    </p>
  <% end %>
</div>

<%= link_to "New quest", new_quest_quest_path %>
