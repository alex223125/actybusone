<%= simple_form_for @pin, html: { multipart: true } do |f| %>
  <% if @pin.errors.any? %>
    <div id="errors">
      <h2></h2>
      <%= pluralize(@pin.errors.count, "error") %>
      prevented this Pin from saving
      <ul>
        <% @pin.errors.full_messages.each do |msg| %>
          <li>
            <%= msg %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div class="form-group">
    <%= f.input :image, input_html: { class: 'form-control' } %>
  </div>
  <div class="form-group">
    <%= f.input :title, input_html: { class: 'form-control' } %>
  </div>

  Select activities:
  <div class="form-group">
    <%#= f.collection_select :direction_ids, Directions::Direction.all, :id, :name, :prompt => "Category", :multiple => true %>
    <%#= f.association :directions, collection: @all_users, input_html: { class: 'multiselectuser'} %>

    <%= select_tag 'pin[direction_ids]',
                   options_from_collection_for_select(Directions::Direction.all, :id, :name),
                   multiple: true, class: 'multiselectuser' %>
  </div>

  Content type:
  <div class="form-group">
    <%= f.select :pin_content_category_id, options_for_select(@pin_content_categories.collect { |cat| [cat.title, cat.id]}), :prompt => 'Select'%>
    <%#= f.select :pin_content_category, options_from_collection_for_select(PinContentCategory.all, 'id', 'title'), :prompt => 'Select' %>
    <%#= f.select :pin_content_category, PinContentCategory.all, :id, :name, :prompt => "Category" %>
    <%#= f.collection_select :category_ids, Category.all, :id, :name, :prompt => "Category", :multiple => true %>
  </div>
  <div class="form-group">
    <%= f.input :description, input_html: { class: 'form-control' } %>
  </div>
  <%= f.button :submit, class: "btn btn-primary" %>
<% end %>